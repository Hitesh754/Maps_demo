# ==============================================================================
# Meridian Geospatial Intelligence Platform — Development Environment Defaults
# ==============================================================================
# These are SAFE DEFAULT credentials for local development inside Docker Compose.
# NEVER commit production credentials or actual API keys to version control.

# Application Environment & Logging
ENV=development
LOG_LEVEL=info
API_PORT=8080

# PostgreSQL + PostGIS (Port 5432)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=meridian
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# NATS JetStream (Client: 4222, Monitoring: 8222)
NATS_HOST=nats
NATS_PORT=4222
NATS_URL=nats://127.0.0.1:4222

# S3-Compatible Storage / MinIO (API: 9000, Web Console: 9001)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=meridian-media
S3_FORCE_PATH_STYLE=true

# Frontend Client Public Endpoints
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# For Android emulator use 10.0.2.2; for iOS simulator use localhost; for physical phone use LAN IP
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Region Configuration & Map Tile Serving (Prompt 03)
REGION_CONFIG_PATH=config/region.json
TILES_BASE_URL=http://127.0.0.1:8082
MAP_ASSETS_BASE_URL=http://127.0.0.1:8083
